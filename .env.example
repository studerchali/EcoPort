# Supabase — copia este archivo a .env.local y rellena con tus credenciales
# Dashboard: https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Desarrollo: true = acceso sin login | Producción: false
VITE_ALLOW_PUBLIC_ACCESS=false
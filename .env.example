# =============================================================================
# EcoPort — Variables de entorno
# Copia a .env.local (desarrollo) o configúralas en Vercel → Environment Variables
# NUNCA subas .env.local a Git.
# =============================================================================

# --- Supabase (obligatorias en producción) ---
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Ejecuta supabase/migrations/001_initial_schema.sql en el SQL Editor.
# RLS aísla ingresos, gastos e inversiones por user_id.

# --- App ---
VITE_APP_URL=http://localhost:5174

# Desarrollo: true = acceso sin login | Producción: false u omitir
VITE_ALLOW_PUBLIC_ACCESS=false

# --- Cuenta demo (opcional) ---
# Crear usuario en Supabase: npm run setup:demo
VITE_DEMO_ENABLED=true
VITE_DEMO_EMAIL=demo@ecoport.io
VITE_DEMO_PASSWORD=change_me_demo_password

# --- OAuth (activar solo cuando el proveedor esté configurado en Supabase) ---
VITE_OAUTH_GOOGLE_ENABLED=false
VITE_OAUTH_APPLE_ENABLED=false
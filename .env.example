# =============================================================================
# EcoPort — Variables de entorno
# Copia a .env.local (desarrollo) o configúralas en Vercel → Environment Variables
# =============================================================================

# Supabase (obligatorias en producción)
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# URL pública de la app (producción: https://tu-dominio.vercel.app)
# Usada para documentación OAuth; configura también Site URL en Supabase Auth.
VITE_APP_URL=http://localhost:5174

# Desarrollo: true = acceso sin login | Producción: DEBE ser false o omitirse
VITE_ALLOW_PUBLIC_ACCESS=false

# Cuenta demo pública (botón "Probar cuenta demo" en landing y login)
# Crear usuario: npm run setup:demo
VITE_DEMO_ENABLED=true
VITE_DEMO_EMAIL=demo@ecoport.io
VITE_DEMO_PASSWORD=EcoPortDemo2026!